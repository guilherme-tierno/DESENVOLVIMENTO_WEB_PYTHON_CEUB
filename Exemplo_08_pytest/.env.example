# Copie este arquivo para .env e ajuste para o seu ambiente local.
# O .env NÃO deve ser commitado.

# Banco MySQL local (formato SQLAlchemy)
DATABASE_URL=mysql+pymysql://salvador:salvador@localhost:3306/helpdesk_lite_db

# Chave para assinar sessões e JWT.
# Em produção, gere algo aleatório de pelo menos 32 caracteres.
SECRET_KEY=dev-secret-troque-em-producao

FLASK_APP=run.py
FLASK_ENV=development
